{% if options | length %}
    <div class="colour-palettes">
        {% for option in options %}
            <label class="colour-palettes__option" title="{{ option.label }}">
                <input
					class="colour-palettes__input"
					type="radio"
					name="{{ field.handle }}"
					value="{{ option.class }}"
					aria-label="{{ option.label }}"
					{% if value == option.class %}checked{% endif %}
				>

                <span class="colour-palettes__swatch" aria-hidden="true">
					<span
						class="colour-palettes__colour"
						style="background: {{ option.color }};"
					></span>
				</span>

                <span class="colour-palettes__label">
                    {{ option.label }}
                </span>
            </label>
        {% endfor %}
    </div>
{% else %}
    <p class="light">
        No colours found. Choose a configured palette in the field settings.
    </p>
{% endif %}

{% css %}
.colour-palettes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.colour-palettes__option {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: pointer;
}

.colour-palettes__input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
}

.colour-palettes__swatch {
    display: inline-block;
    width: 35px;
    height: 35px;
    border-radius: 8px;
    border: 1px solid #ccc;
    outline: 2px solid transparent;
    outline-offset: 1px;
    transition: outline-color 150ms ease;
	position: relative;
	background-color: #fff;
	overflow: hidden;
	background-image: conic-gradient(
		#ddd 25%,
		transparent 0 50%,
		#ddd 0 75%,
		transparent 0
	);
	background-size: 10px 10px;
}

.colour-palettes__colour {
    position: absolute;
    inset: 0;
    border-radius: inherit;
}

.colour-palettes__label {
    display: none;
}

.colour-palettes__input:checked + .colour-palettes__swatch {
    outline-color: #2563eb;
}

.colour-palettes__input:focus-visible + .colour-palettes__swatch {
    outline: 3px dashed #2563eb;
}
{% endcss %}
